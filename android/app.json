{
  "expo": {
    "name": "Money Tracker",
    "slug": "money-tracker-ts",
    "version": "2.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.shwesiads.moneytracker",
      "versionCode": 3,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071621"
      }
    },
    "ios": {
      "bundleIdentifier": "com.shwesiads.moneytracker"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071621",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#071621",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile picture for your local Money Tracker account."
        }
      ]
    ],
    "extra": {
      "localOnly": true
    },
    "icon": "./assets/icon.png"
  }
}
