{
  "expo": {
    "name": "Money Tracker",
    "slug": "money-tracker-ts",
    "version": "2.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.shwesiads.moneytracker",
      "versionCode": 2,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071621"
      }
    },
    "ios": {
      "bundleIdentifier": "com.shwesiads.moneytracker"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071621",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#071621",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "extra": {
      "localOnly": true
    },
    "icon": "./assets/icon.png"
  }
}
