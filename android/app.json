{
  "expo": {
    "name": "Money Tracker",
    "slug": "money-tracker-ts",
    "version": "2.6.4",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.shwesiads.moneytracker",
      "versionCode": 13,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071621"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.shwesiads.moneytracker"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071621",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#071621",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile picture for your local Money Tracker account."
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "MoneyWidget",
              "displayName": "Money Tracker • Balance",
              "description": "Dark balance, monthly income and expenses, optional privacy mode",
              "android": {
                "minWidth": 180,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "initialLayout": "./src/MoneyWidget.tsx",
                "resizeMode": "both"
              }
            },
            {
              "name": "MoneyWidgetSmall",
              "displayName": "Money Tracker • Compact",
              "description": "Compact, private money balance widget",
              "android": {
                "minWidth": 120,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "initialLayout": "./src/MoneyWidgetSmall.tsx",
                "resizeMode": "both"
              }
            }
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Money Tracker to scan your Windows login QR code."
        }
      ]
    ],
    "extra": {
      "localOnly": true
    },
    "icon": "./assets/icon.png"
  }
}
